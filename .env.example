# Copy to .env and fill in what you have. Everything is optional. Without Ollama the
# AI features say they are unavailable; the rule-based engines still work.

# --- Server ---
PORT=8787
DB_PATH=./data/constraintforge.db
# Where the browser app is served (used for OAuth redirects back to the UI)
APP_URL=http://localhost:5173

# --- AI (local Ollama — no API key) ---
# Powers photo recognition, product ideas, build plans, channel strategy, advisor
# explanations and the assistant. Install Ollama (https://ollama.com), then pull the
# model:  ollama pull qwen3-vl:4b-instruct
# The startup log and Settings → AI engine show whether Ollama and the model were found.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:4b-instruct # must support image input for scanning (qwen3-vl, gemma3, llava…)
OLLAMA_NUM_CTX=6144               # one context for every call (changing it reloads the model); 6144 fits a 4B model on a 4 GB GPU
OLLAMA_NUM_GPU=99                 # layers on the GPU: 99 = all (≈4× faster than Ollama's default split on a 4 GB laptop GPU);
                                  # remove the line to let Ollama decide. If the GPU can't hold them the app falls back automatically.
# AI_MAX_IDEAS=8                  # candidate ideas per request (each ≈ 4–5 s at full GPU speed; unrealistic ones are filtered out)
# OLLAMA_THINK=true               # let thinking models reason first (better, much slower)
# OLLAMA_KEEP_ALIVE=30m           # how long the model stays loaded between requests (the server pre-loads it at start)
# AI_TIMEOUT_MS=120000            # fail if Ollama sends nothing for this long (includes model load)
# AI_MAX_REQUEST_MS=600000        # hard cap for one generation
# AI_ENABLED=false                # switch all AI features off

# --- Web research ---
# Real searches run by the server; the model may only cite URLs these searches returned.
#   duckduckgo (default, no key) | searxng (self-hosted, set SEARXNG_URL) |
#   ollama (Ollama's hosted search, needs OLLAMA_API_KEY) | off
SEARCH_PROVIDER=duckduckgo
# SEARXNG_URL=http://localhost:8080
# OLLAMA_API_KEY=

# --- Shopify (optional) ---
# Create an app in the Shopify Partner Dashboard / Dev Dashboard and set its
# redirect URL to: <SHOPIFY_CALLBACK_BASE>/api/integrations/shopify/callback
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products,read_orders
SHOPIFY_API_VERSION=2025-07
# Public base URL of this API server as Shopify can reach it (e.g. an https tunnel)
SHOPIFY_CALLBACK_BASE=http://localhost:8787

# --- Uploads ---
MAX_IMAGE_MB=8

# Copy to .env and fill in what you have. Without GEMINI_API_KEY the AI features say they
# are unavailable; the rule-based engines still work.

# --- Server ---
PORT=8787
DB_PATH=./data/constraintforge.db
# Where the browser app is served (used for OAuth redirects back to the UI)
APP_URL=http://localhost:5173

# --- AI (Google Gemini, model gemini-3.8-flash) ---
# Powers photo recognition, product ideas, build plans, selling suggestions, advisor
# explanations and the assistant. Create a key at https://aistudio.google.com/apikey.
# The key is read only by the server. Never put it in a VITE_ variable (those are bundled
# into the browser code) and never commit it. On Vercel, set it in Project → Settings →
# Environment Variables instead of a file.
GEMINI_API_KEY=
# AI_MAX_IDEAS=8                  # candidate ideas per request (unrealistic ones are filtered out)
# AI_TIMEOUT_MS=120000            # fail a Gemini request that takes longer (default 120 s on Vercel, 180 s locally)
# AI_ENABLED=false                # switch all AI features off
# AI_DEBUG=1                      # log raw model replies to the server log (e.g. Vercel → Logs)

# --- Web research ---
# Real searches run by the server; the model may only cite URLs these searches returned.
#   duckduckgo (default, no key) | searxng (self-hosted, set SEARXNG_URL) | off
SEARCH_PROVIDER=duckduckgo
# SEARXNG_URL=http://localhost:8080

# --- Shopify (optional) ---
# Create an app in the Shopify Partner Dashboard / Dev Dashboard and set its
# redirect URL to: <SHOPIFY_CALLBACK_BASE>/api/integrations/shopify/callback
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products,read_orders
SHOPIFY_API_VERSION=2025-07
# Public base URL of this API server as Shopify can reach it (e.g. an https tunnel)
SHOPIFY_CALLBACK_BASE=http://localhost:8787

# --- Uploads ---
MAX_IMAGE_MB=8

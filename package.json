{
  "name": "constraintforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn the materials, tools, skills and budget you already have into products you can build, sell and improve.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"node --watch server/index.js\" \"vite\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:live": "node --test --test-concurrency=1 --test-timeout=3600000 tests/live/*.test.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "framer-motion": "^14.3.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.59.0",
    "multer": "^2.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.4"
  }
}
